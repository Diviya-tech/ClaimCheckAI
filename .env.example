# ClaimCheck AI — environment variables
# Copy this file to `.env` and fill in your real keys. `.env` is gitignored.

# Anthropic Claude API key — required for claim extraction and verdict generation.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tavily API key — used by the supplementary web search in the evidence retriever
# (weeks 5-6). Not required for Week 1 claim extraction.
# Get one at https://app.tavily.com/
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
